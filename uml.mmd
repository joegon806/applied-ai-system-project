flowchart TD
    subgraph User
USER[Human / CLI User]
    end

    subgraph Dataset
        DS[SAMPLE_POSTS, TRUE_LABELS, EVAL_LABELS]
    end

    subgraph RuleBasedModel
        MA[MoodAnalyzer]
    end

    subgraph MLModel
        VEC[CountVectorizer]
        ML[LogisticRegression]
    end

    subgraph reliability.py
        REL[predict_reliable]
        EVAL[Rule-based evaluation of sample data]
        REP[Reliablity Report]
        REOUT[Reliability Report, Rule-based Evaluation report]
    end

    subgraph Test Suite
        TEST[test_predict_reliable.py]
    end
    
    USER -->|enters text for rule-based classification| MA
    MA -->|label prediction for user text| REL
    REL -->|reliability determined for user text| Output[CLI output]
    
    DS -->|fit training data| VEC
    USER -->|enters text for ML classification| VEC
    VEC -->|transforms text into features| ML
    ML -->|predicts mood label| Output
    
    DS -->|for checking reliability| REP
    REP --> REOUT
    DS -->|sample text for evaluation| MA
    MA --> |label predictions for sample text| REL
    REL -->|reliability determined for sample text| EVAL
    DS -->|true_labels for comparing predictions| EVAL
    EVAL --> REOUT
    REOUT --> Output

    reliability.py -->|goes through automated testing| TEST
    TEST -->|prints test results| Output
    USER -->|reviews command-line output| Output

